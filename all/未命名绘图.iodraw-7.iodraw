        <mxCell id="dAfzWq3VzhXc7XNo-PkO-49" value="&lt;b&gt;Query / Key projections&lt;/b&gt;&lt;br&gt;&lt;br&gt;qₛ = Qₛ(h꜀),  kₛᵢ = Kₛ(hᵢ)&lt;br&gt;FC(64 → 16) → ReLU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF4FB;strokeColor=#779AD0;strokeWidth=1.5;fontFamily=Arial;fontSize=21;fontColor=#283747;spacing=10;" vertex="1" parent="1">
