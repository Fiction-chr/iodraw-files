        <mxCell id="dAfzWq3VzhXc7XNo-PkO-51" value="&lt;b&gt;Quality-adjusted logits&lt;/b&gt;&lt;br&gt;&lt;br&gt;eₛᵢ = qₛᵀkₛᵢ / √16&lt;br&gt;+ log(max(rₛᵢ, 10⁻⁶))" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#AAB5C0;strokeWidth=1.5;fontFamily=Arial;fontSize=22;fontColor=#283747;spacing=10;" vertex="1" parent="1">
