        <mxCell id="dAfzWq3VzhXc7XNo-PkO-48" value="h꜀: center token    hᵢ: a token in Ωₛ    Nₛ = s²    All projections below are specific to scale s." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=Arial;fontSize=20;fontColor=#283747;spacing=10;align=left;spacing=0;fontColor=#6B7888;fontStyle=0;" vertex="1" parent="1">
