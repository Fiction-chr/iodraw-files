        <mxCell id="dAfzWq3VzhXc7XNo-PkO-50" value="&lt;b&gt;Center–neighbor quality&lt;/b&gt;&lt;br&gt;&lt;br&gt;rₛᵢ = Rₛ([h꜀; hᵢ; |h꜀ − hᵢ|])&lt;br&gt;192 → 32 → 1; GELU → sigmoid" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F1FA;strokeColor=#AD8BC3;strokeWidth=1.5;fontFamily=Arial;fontSize=20;fontColor=#283747;spacing=10;" vertex="1" parent="1">
